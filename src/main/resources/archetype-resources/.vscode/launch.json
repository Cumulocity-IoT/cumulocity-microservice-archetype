{
    "configurations": [
        {
            "type": "java",
            "name": "Spring Boot-App<${artifactId}>",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "mainClass": "${package}.App",
            "projectName": "${artifactId}",
            "args": "",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                    "C8Y_BOOTSTRAP_TENANT": "",        
                    "C8Y_BASEURL": "",
                    "C8Y_BOOTSTRAP_USER": "",
                    "C8Y_BOOTSTRAP_PASSWORD": "",
                    "C8Y_MICROSERVICE_ISOLATION": "MULTI_TENANT"
            },
            "vmArgs": "-Dlogging.config=src/main/configuration/${artifactId}-logging.xml"
        }
    ]
}